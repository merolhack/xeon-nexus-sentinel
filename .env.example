# Variables de Entorno de Ejemplo para Xeon-Nexus-Sentinel
# Copia este archivo como .env y define los valores específicos de tu entorno.
# El archivo .env real NUNCA debe subirse a Git (protegido por .gitignore).

ADMIN_USER=administrador
ADMIN_PASSWORD_HASH=ejemplo_hash_sha256_admin
JWT_SECRET_KEY=ejemplo_clave_secreta_jwt_de_64_caracteres
SERVER_INGEST_TOKEN=ejemplo_token_ingest_para_almalinux
NEXT_PUBLIC_CLOUD_RELAY_URL=https://xeon-nexus-cloud-relay.onrender.com
GITGUARDIAN_API_KEY=ejemplo_pat_gitguardian
