# Variables de Entorno de Ejemplo para Xeon-Nexus-Sentinel
# Copia este archivo como .env y define los valores específicos de tu entorno.
# El archivo .env real NUNCA debe subirse a Git (protegido por .gitignore).

# Usuario Administrador
ADMIN_USER=administrador

# Hash SHA-256 en hexadecimal de la contraseña maestra
# Generado con: python3 -c "import hashlib; print(hashlib.sha256(b'TU_PASSWORD').hexdigest())"
ADMIN_PASSWORD_HASH=TU_HASH_SHA256_AQUI

# Clave secreta para firma y verificación de tokens JWT (HS256)
JWT_SECRET_KEY=TU_JWT_SECRET_KEY_ALEATORIO_64_CHARS

# Token precompartido para ingestión segura desde AlmaLinux (X-Server-Token)
SERVER_INGEST_TOKEN=TU_SERVER_INGEST_TOKEN_ALEATORIO_48_CHARS

# URL Pública HTTPS del Cloud Relay en Render
NEXT_PUBLIC_CLOUD_RELAY_URL=https://tu-servicio.onrender.com
