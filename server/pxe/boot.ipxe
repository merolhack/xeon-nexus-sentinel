#!ipxe
# ========================================================
#   Xeon Nexus Sentinel - Selector de Arranque Automatizado
#   Modo: Vía B (100% Red Headless con inst.stage2 Oficial)
# ========================================================

set menu-timeout 3000
set submenu-timeout ${menu-timeout}

:start
menu Xeon Nexus Sentinel - Menu de Inicio
item --default --key i reinstall   [I] Instalar AlmaLinux 9 (Kickstart Oficial inst.stage2)
item --key s local_sas             [S] Arrancar AlmaLinux 9 desde Disco SAS Local (0x80)
item --key r rescue_boot           [R] Modo Rescate de Linux por Red
choose --timeout ${menu-timeout} --default reinstall target && goto ${target}

:reinstall
echo ========================================================
echo   Iniciando Instalacion Desatendida Kickstart...
echo   Kernel: AlmaLinux 9 pxeboot + inst.stage2 Remoto
echo ========================================================
set almalinux_url http://repo.almalinux.org/almalinux/9/BaseOS/x86_64/os
set base-url http://192.168.137.1:8000
kernel ${base-url}/vmlinuz ip=dhcp inst.stage2=${almalinux_url} inst.ks=${base-url}/ks.cfg inst.text inst.noverifyssl nomodeset console=tty0 console=ttyS0,115200n8
initrd ${base-url}/initrd.img
boot

:local_sas
echo ========================================================
echo   Arrancando AlmaLinux 9 desde disco SAS local (0x80)...
echo ========================================================
sanboot --no-describe --drive 0x80 || goto fallback_exit

:fallback_exit
echo [AVISO] sanboot fallo o no respondio. Intentando salir a BIOS...
exit 1

:rescue_boot
echo ========================================================
echo   Cargando Kernel de Rescate AlmaLinux 9...
echo ========================================================
set almalinux_url http://repo.almalinux.org/almalinux/9/BaseOS/x86_64/os
set base-url http://192.168.137.1:8000
kernel ${base-url}/vmlinuz ip=dhcp inst.stage2=${almalinux_url} inst.rescue inst.text inst.noverifyssl nomodeset console=tty0 console=ttyS0,115200n8
initrd ${base-url}/initrd.img
boot
